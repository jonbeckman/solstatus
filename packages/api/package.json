{
  "name": "@solstatus/api",
  "version": "3.0.0",
  "private": true,
  "description": "API workers for SolStatus uptime monitoring service",
  "keywords": [
    "api",
    "cloudflare",
    "monitoring",
    "solstatus",
    "workers"
  ],
  "homepage": "https://github.com/SolZeroAI/solstatus/tree/master/packages/api#readme",
  "bugs": {
    "url": "https://github.com/SolZeroAI/solstatus/issues"
  },
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SolZeroAI/solstatus.git",
    "directory": "packages/api"
  },
  "files": [
    "src",
    "infra",
    "README.md"
  ],
  "type": "module",
  "imports": {
