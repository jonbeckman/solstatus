{
  "name": "@solstatus/api",
  "version": "3.0.0",
  "description": "API workers for SolStatus uptime monitoring service",
  "keywords": [
    "api",
    "cloudflare",
    "monitoring",
    "solstatus",
    "workers"
  ],
  "homepage": "https://github.com/jonbeckman/solstatus/tree/master/packages/api#readme",
  "bugs": {
    "url": "https://github.com/jonbeckman/solstatus/issues"
  },
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jonbeckman/solstatus.git",
    "directory": "packages/api"
  },
  "files": [
    "src",
    "infra",
    "README.md"
  ],
  "type": "module",
  "imports": {
    "@/infra/*": "./infra/*",
    "@/*": "./src/*"
  },
  "exports": {
    ".": "./src/index.ts",
    "./monitor-exec": "./src/monitor-exec.ts",
    "./monitor-trigger": "./src/monitor-trigger.ts",
    "./infra": "./infra/index.ts"
  },
  "scripts": {
    "dev": "concurrently --kill-others --names \"EXEC,TRGR\" --prefix-colors \"blue,magenta\" \"nub run dev:api-exec\" \"wait-on http://localhost:8787 && nub run dev:api-trigger\"",
    "dev:api-exec": "wrangler dev --persist-to=../infra/.wrangler/state -c ../infra/wrangler-monitor-exec.jsonc --port 8787",
    "dev:api-trigger": "wrangler dev --persist-to=../infra/.wrangler/state -c ../infra/wrangler-monitor-trigger.jsonc --port 8788",
    "deploy:prod": "nub run deploy:prod:api-exec && nub run deploy:prod:api-trigger",
    "deploy:prod:api-exec": "wrangler deploy --env prod -c ../infra/wrangler-monitor-exec.jsonc",
    "deploy:prod:api-trigger": "wrangler deploy --env prod -c ../infra/wrangler-monitor-trigger.jsonc",
    "types": "tsc"
  },
  "dependencies": {
    "@solstatus/common": "workspace:*",
    "diffable-objects": "^0.1.1",
    "drizzle-orm": "1.0.0-rc.5-ab785fc",
    "drizzle-seed": "1.0.0-rc.5-ab785fc",
    "http-status-codes": "^2.3.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250702.0",
    "@types/node": "^24.12.4",
    "alchemy": "2.0.0-beta.72",
    "concurrently": "^9.2.0",
    "drizzle-kit": "1.0.0-rc.5-ab785fc",
    "typescript": "7.0.2",
    "wait-on": "^8.0.3"
  }
}
