    "./infra": "./infra/index.ts"
  },
  "scripts": {
    "types": "tsrs"
  },
  "dependencies": {
    "@solstatus/common": "workspace:*",
    "diffable-objects": "^0.1.1",
    "drizzle-orm": "1.0.0-rc.5-ab785fc",
    "http-status-codes": "^2.3.0"
  },
  "devDependencies": {
    "@alchemy.run/cloudflare": "2.0.0-beta.85",
    "@cloudflare/workers-types": "^5.20261022.1",
    "@libsql/client": "0.18.0",
    "@types/node": "^24.12.4",
    "alchemy": "2.0.0-beta.85",
    "react": "^19.1.0",
    "tsrs": "0.20.1-ts7.1.0-beta",
    "typescript": "7.0.2"
  }
