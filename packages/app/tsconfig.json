{
  "extends": "../../tsconfig.base.json",
  "include": [
    "./infra/**/*.ts",
    "./src/**/*.ts",
    "./src/**/*.tsx",
    "./src/css.d.ts",
    "./src/vite-env.d.ts",
    "./vite.config.ts",
    "./cloudflare-env.d.ts"
  ],
  "exclude": ["node_modules", "dist", "public", "src/registry/**"],
  "compilerOptions": {
    "types": ["@types/node", "@cloudflare/workers-types", "vite/client"],
    "rootDir": "./",
    "paths": {
      "@/infra/*": ["./infra/*"],
      "@/*": ["./src/*"]
    },
    "outDir": "./dist",
    "tsBuildInfoFile": "./dist/tsconfig.tsbuildinfo",
    "jsx": "react-jsx",
    "allowJs": true,
    "incremental": false,
    "esModuleInterop": true,
    "module": "esnext"
  }
}
