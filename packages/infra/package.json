{
  "name": "@solstatus/infra",
  "version": "2.1.1",
  "description": "Infrastructure configuration and deployment tools for SolStatus",
  "keywords": [
    "cloudflare",
    "deployment",
    "iac",
    "infrastructure",
    "solstatus"
  ],
  "homepage": "https://github.com/jonbeckman/solstatus/tree/master/packages/infra#readme",
  "bugs": {
    "url": "https://github.com/jonbeckman/solstatus/issues"
  },
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jonbeckman/solstatus.git",
    "directory": "packages/infra"
  },
  "files": [
    "src",
    "scripts",
    "README.md",
    "drizzle.config.ts",
    "wrangler*.jsonc"
  ],
  "type": "module",
  "imports": {
    "@/*": "./src/*"
  },
  "exports": {
    ".": "./src/alchemy.run.ts"
  },
  "scripts": {
    "infra:up": "alchemy deploy ./src/alchemy.run.ts --stage dev",
    "infra:destroy": "alchemy destroy ./src/alchemy.run.ts --stage dev",
    "infra:plan": "alchemy plan ./src/alchemy.run.ts --stage dev",
    "infra:dev": "alchemy dev ./src/alchemy.run.ts --stage dev",
    "db:create": "wrangler d1 execute solstatus-local --local --command='SELECT 1' --cwd ../../ --config ./packages/infra/wrangler.jsonc",
    "db:create:prod": "wrangler d1 create solstatus-prod",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "wrangler d1 migrations apply DB --local --cwd ../../ --config ./packages/infra/wrangler.jsonc",
    "db:migrate:prod": "wrangler d1 migrations apply DB --env prod --remote",
    "db:seed": "tsx scripts/seed.ts",
    "db:setup": "nub run db:create && nub run db:generate && nub run db:migrate && nub run db:seed",
    "db:studio": "drizzle-kit studio",
    "db:studio:prod": "APP_ENV=prod drizzle-kit studio",
    "wrangler:gen": "tsx scripts/genWranglerConfig.ts",
    "types": "tsc"
  },
  "dependencies": {
    "@solstatus/api": "workspace:*",
    "@solstatus/app": "workspace:*",
    "@solstatus/common": "workspace:*",
    "alchemy": "2.0.0-beta.72"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250702.0",
    "@libsql/client": "^0.15.9",
    "@types/node": "^24.12.4",
    "dotenv": "16.5.0",
    "drizzle-kit": "1.0.0-rc.5-ab785fc",
    "drizzle-orm": "1.0.0-rc.5-ab785fc",
    "drizzle-seed": "1.0.0-rc.5-ab785fc",
    "typescript": "7.0.2",
    "wrangler": "^4.22.0",
    "zod": "4.4.3"
  }
}
