{
  "name": "@solstatus/infra",
  "version": "3.0.0",
  "description": "Infrastructure configuration and deployment tools for SolStatus",
  "keywords": [
    "cloudflare",
    "deployment",
    "iac",
    "infrastructure",
    "solstatus"
  ],
  "homepage": "https://github.com/SolZeroAI/solstatus/tree/master/packages/infra#readme",
  "bugs": {
    "url": "https://github.com/SolZeroAI/solstatus/issues"
  },
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SolZeroAI/solstatus.git",
    "directory": "packages/infra"
  },
  "files": [
    "src",
    "README.md",
    "drizzle.config.ts"
  ],
  "type": "module",
  "imports": {
    "@/*": "./src/*"
  },
  "exports": {
    ".": "./src/alchemy.run.ts"
  },
  "scripts": {
    "infra:up": "alchemy deploy ./src/alchemy.run.ts --stage dev",
    "infra:destroy": "alchemy destroy ./src/alchemy.run.ts --stage dev",
    "infra:plan": "alchemy plan ./src/alchemy.run.ts --stage dev",
    "dev": "node --env-file-if-exists=../../.env ../../node_modules/alchemy/bin/cli.js dev ./src/alchemy.run.ts --stage dev",
    "db:generate": "drizzle-kit generate",
    "db:studio": "drizzle-kit studio",
    "types": "tsrs"
  },
  "dependencies": {
    "@alchemy.run/cloudflare": "2.0.0-beta.85",
    "@solstatus/api": "workspace:*",
    "@solstatus/app": "workspace:*",
    "@solstatus/common": "workspace:*",
    "alchemy": "2.0.0-beta.85"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261022.1",
    "@types/node": "^24.12.4",
    "dotenv": "18.0.9",
    "drizzle-kit": "1.0.0-rc.5-ab785fc",
    "drizzle-orm": "1.0.0-rc.5-ab785fc",
    "react": "^19.1.0",
    "tsrs": "0.20.1-ts7.1.0-beta",
    "typescript": "7.0.2",
    "vite": "^8.0.13",
    "zod": "4.6.7"
  }
}
