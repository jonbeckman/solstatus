// Local D1 only (`db:create`, `db:migrate`). Production workers deploy through Alchemy.
// https://developers.cloudflare.com/workers/wrangler/configuration/
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "solstatus",
  // https://developers.cloudflare.com/workers/configuration/compatibility-flags/#flags-history
  "compatibility_date": "2026-07-21",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "solstatus-local",
      "database_id": "solstatus-local",
      "migrations_dir": "../common/src/db/migrations",
    },
  ],
  "env": {
    "prod": {
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "solstatus-prod",
          "migrations_dir": "../common/src/db/migrations",
        },
      ],
    },
  },
}
