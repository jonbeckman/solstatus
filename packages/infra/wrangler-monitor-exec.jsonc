// Local `wrangler dev` for monitor-exec. Production workers deploy through Alchemy.
// https://developers.cloudflare.com/workers/wrangler/configuration/
{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "monitor-exec",
  "main": "../api/src/monitor-exec.ts",
  // https://developers.cloudflare.com/workers/configuration/compatibility-flags/#flags-history
  "compatibility_date": "2026-07-21",
  "compatibility_flags": ["nodejs_compat"],
  "minify": true,
  "workers_dev": false,
  "observability": {
    "enabled": true,
  },
  "vars": {
    "APP_ENV": "dev",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "solstatus-local",
      "database_id": "solstatus-local",
      "migrations_dir": "../common/src/db/migrations",
    },
  ],
}
