{
  "name": "solstatus",
  "version": "3.0.0",
  "description": "Self host a low-cost, globally-distributed uptime monitoring service on Cloudflare",
  "keywords": [
    "cloudflare",
    "monitoring",
    "solstatus",
    "uptime"
  ],
  "homepage": "https://github.com/jonbeckman/solstatus#readme",
  "bugs": {
    "url": "https://github.com/jonbeckman/solstatus/issues"
  },
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jonbeckman/solstatus.git"
  },
  "bin": {
    "solstatus": "./src/index.ts"
  },
  "workspaces": [
    "packages/*"
  ],
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "imports": {
    "@/*": "./src/*"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "cli": "tsx ./src/index.ts",
    "prepare": "lefthook install",
    "dev": "concurrently --kill-others --names \"API,APP\" --prefix-colors \"bgWhite,bgWhiteBright\" \"nub run dev:api\" \"wait-on http://localhost:8788 && nub run dev:app\"",
    "dev:app": "nub run --filter '@solstatus/app' dev",
    "dev:app:mock": "nub run --filter '@solstatus/app' dev:mock",
    "dev:api": "nub run --filter '@solstatus/api' dev",
    "db:setup": "nub run --filter '@solstatus/infra' db:setup",
    "typecheck": "tsrs --pretty false --noEmit --incremental false && tsrs --pretty false --noEmit --incremental false -p packages/common && tsrs --pretty false --noEmit --incremental false -p packages/api && tsrs --pretty false --noEmit --incremental false -p packages/app && tsrs --pretty false --noEmit --incremental false -p packages/infra && nub run typecheck:e2e",
    "effect:diagnostics": "effect-tsrs diagnostics --project tsconfig.diagnostics.json --lspconfig '{}'",
    "lint": "oxlint --deny-warnings",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt --check .",
    "format:fix": "oxfmt .",
    "test": "nub run test:e2e",
    "tegami": "tsx scripts/tegami.mts",
    "clean": "rm -rf ./node_modules/ ./packages/*/node_modules/ ./dist/ ./packages/*/dist/",
    "clean:builds": "rm -rf ./dist/ ./packages/*/dist/",
    "build": "nub run typecheck",
    "types": "nub run typecheck",
    "types:each": "nub run --filter '@solstatus/common' types && nub run --filter '@solstatus/api' types && nub run --filter '@solstatus/app' types && nub run --filter '@solstatus/infra' types",
    "test:e2e": "tsx scripts/e2e/run.ts",
    "test:e2e:live": "tsx scripts/e2e/run.ts --no-cache",
    "test:e2e:cache-strict": "tsx scripts/e2e/run.ts --strict-cache",
    "test:e2e:install": "nub exec e2e-web install chromium --with-deps",
    "test:e2e:list": "nub exec e2e list",
    "test:e2e:cleanup": "tsx scripts/e2e/cleanup.ts",
    "test:e2e:mcp": "tsx scripts/e2e/run.ts --mcp",
    "typecheck:e2e": "tsrs --pretty false --noEmit --incremental false -p tests/tsconfig.json"
  },
  "dependencies": {
    "@effect/platform-node": "4.1.2",
    "@solstatus/infra": "workspace:*",
    "alchemy": "2.0.0-beta.85",
    "dotenv": "18.0.9",
    "effect": "4.1.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261022.1",
    "@e2e-dev/decision": "0.3.1",
    "@e2e-dev/github": "0.4.4",
    "@e2e-dev/web": "0.15.4",
    "@mpsuesser/oxlint-plugin-effect": "0.6.0",
    "@oxlint/plugins": "1.90.0",
    "@types/node": "^24.12.4",
    "@types/pngjs": "6.0.5",
    "@yielded/effect-tsrs": "0.2.3",
    "ai": "7.0.160",
    "concurrently": "^10.0.0",
    "e2e": "0.22.0",
    "jpeg-js": "0.4.4",
    "lefthook": "^2.2.2",
    "oxfmt": "0.75.0",
    "oxlint": "1.90.0",
    "oxlint-plugin-solzero": "^0.1.0",
    "pngjs": "7.0.0",
    "tegami": "1.5.0",
    "tsrs": "0.20.1-ts7.1.0-beta",
    "tsx": "^4.20.3",
    "typescript": "7.0.2",
    "wait-on": "^8.0.3",
    "wrangler": "^4.22.0"
  },
  "overrides": {
    "@alchemy.run/cloudflare": "2.0.0-beta.85",
    "@effect/platform-node": "4.1.2",
    "@effect/platform-node-shared": "4.1.2",
    "@effect/sql-d1": "4.1.2",
    "@libsql/client": "0.18.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "alchemy": "2.0.0-beta.85",
    "drizzle-kit": "1.0.0-rc.5-ab785fc",
    "drizzle-orm": "1.0.0-rc.5-ab785fc",
    "effect": "4.1.2",
    "zod": "4.6.7"
  },
  "devEngines": {
    "packageManager": {
      "name": "nub",
      "version": "0.9.6",
      "onFail": "warn"
    },
    "runtime": {
      "name": "node",
      "version": "24.15.0"
    }
  },
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "packageManager": "nub@0.9.6",
  "allowScripts": {
    "esbuild": true,
    "workerd": true
  }
}
