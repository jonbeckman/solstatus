# Deploy credentials for `nub run cli`. Leave them empty for `nub run dev` and the e2e suite,
# which run the whole stack locally with `alchemy dev`.
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_API_TOKEN=""

# Optional. The CLI generates one when it is empty.
SECRET_ALCHEMY_PASSPHRASE=""

# Required by `nub run dev`. Signs dashboard sessions. Generate one with `openssl rand -hex 32`.
# scripts/bootstrap.sh fills it in for a new checkout.
BETTER_AUTH_SECRET=""
